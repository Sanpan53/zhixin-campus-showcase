# =============================================================
# 知新校园 · 面试展示版环境变量模板
# 用法：cp .env.example .env，然后替换所有 change-me / your-* 占位符
# 注意：.env 只保存在本地，切勿提交到 Git，也不要打进镜像
# =============================================================

# ---------- 预构建镜像 ----------
# 由完整源码仓库单独构建并推送；本展示包不包含 build: 配置
APP_IMAGE=ghcr.io/sanpan53/zhixin-campus-app:1.0.0
FRONTEND_IMAGE=ghcr.io/sanpan53/zhixin-campus-frontend:1.0.0

# ---------- 应用 ----------
APP_ENV=demo
LOG_LEVEL=INFO

# ---------- PostgreSQL ----------
DB_NAME=zhixin
DB_USERNAME=zhixin
DB_PASSWORD=change-me-db-password

# ---------- Redis ----------
REDIS_DB=0

# ---------- MinIO ----------
MINIO_ROOT_USER=zhixin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=zhixin-documents

# ---------- 大模型服务（阿里云百炼 DashScope）----------
# 只填写自己的 Key；不要使用他人或生产环境的 Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# ---------- Reranker ----------
RERANKER_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANKER_MODEL=qwen3-rerank
RERANKER_TIMEOUT_MS=800
RERANKER_TOP_N=5

# ---------- RAG 参数 ----------
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_VECTOR_TOP_K=20
RAG_FULLTEXT_TOP_K=20
RAG_RETURN_TOP_N=5
RAG_MIN_SCORE=0.3
RAG_CONTEXT_MAX_TOKENS=3000

# ---------- 文件上传 ----------
MAX_FILE_SIZE_MB=50
MAX_REQUEST_SIZE_MB=100
